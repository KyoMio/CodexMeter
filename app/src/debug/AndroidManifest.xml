<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Debug-only fixture injection permission. `signature` protection means only packages
         signed with the same key can hold it — no ordinary app can ever acquire it, so no
         ordinary app can trigger fixture injection. The adb shell user is exempt from
         signature permission checks (ActivityManagerService grants implicit permission to
         root/shell), which is exactly the intended adb-driven test path. This permission
         declaration and the receiver below exist ONLY in the debug manifest merge. -->
    <permission
        android:name="com.kmnexus.codexmeter.debug.permission.SEED_FIXTURE"
        android:protectionLevel="signature" />

    <application>
        <activity
            android:name=".ui.home.HomePreviewActivity"
            android:exported="true"
            android:label="Home Preview"
            android:theme="@style/Theme.CodexMeter" />
        <activity
            android:name=".ui.spike.MotionPreviewActivity"
            android:exported="true"
            android:label="Motion Preview"
            android:theme="@style/Theme.CodexMeter" />
        <activity
            android:name=".widget.WidgetPreviewActivity"
            android:exported="true"
            android:label="Widget Preview"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Exported because Android 12+ policy rejects even shell-origin broadcasts to
             non-exported receivers (the failure mode CM-5 R1 item 1 proved). Reachability
             for ordinary apps is still impossible: the receiver requires the signature-level
             SEED_FIXTURE permission above, which only same-signature packages can hold. -->
        <receiver
            android:name=".debug.DebugFixtureReceiver"
            android:exported="true"
            android:permission="com.kmnexus.codexmeter.debug.permission.SEED_FIXTURE">
            <intent-filter>
                <action android:name="com.kmnexus.codexmeter.debug.SEED_FIXTURE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
